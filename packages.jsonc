{
  "all": [
    {
      "name": "ripgrep",
      "sourceUrl": "https://github.com/BurntSushi/ripgrep",
      "packageIds": {
        "scoop": "main/ripgrep",
        "winget": "BurntSushi.ripgrep.MSVC"
      },
      "description": "ripgrep recursively searches directories for a regex pattern while respecting your gitignore"
    },
    {
      "name": "NeoVim",
      "sourceUrl": "https://github.com/neovim/neovim",
      "packageIds": {
        "scoop": "main/neovim",
        "winget": "Neovim.Neovim"
      },
      "description": "Vim-fork focused on extensibility and usability"
    },
    {
      "name": "MS Edit",
      "sourceUrl": "https://github.com/microsoft/edit",
      "packageIds": {
        "scoop": "main/edit",
        "winget": "Microsoft.Edit"
      },
      "description": "We all edit."
    },
    // shellInit entries end up in the PowerShell profile in this file's order.
    // starship must come before atuin, since atuin wraps the prompt function starship defines.
    {
      "name": "starship",
      "sourceUrl": "https://github.com/starship/starship",
      "packageIds": {
        "scoop": "main/starship",
        "winget": "Starship.Starship"
      },
      "description": "☄🌌️  The minimal, blazing-fast, and infinitely customizable prompt for any shell!",
      "shellInit": {
        "command": "starship",
        "powershell": [
          "Invoke-Expression (& starship init powershell)"
        ]
      }
    },
    {
      "name": "zoxide",
      "sourceUrl": "https://github.com/ajeetdsouza/zoxide",
      "packageIds": {
        "scoop": "main/zoxide",
        "winget": "ajeetdsouza.zoxide"
      },
      "description": "A smarter cd command. Supports all major shells.",
      "shellInit": {
        "command": "zoxide",
        "powershell": [
          "Invoke-Expression (& { (zoxide init powershell | Out-String) })"
        ]
      }
    },
    {
      "name": "atuin",
      "sourceUrl": "https://github.com/atuinsh/atuin",
      "packageIds": {
        "scoop": "main/atuin",
        "winget": "Atuinsh.Atuin"
      },
      "description": "✨ Making your shell magical",
      "shellInit": {
        "command": "atuin",
        "powershell": [
          "atuin init powershell | Out-String | Invoke-Expression"
        ]
      }
    },
    {
      "name": "fzf",
      "sourceUrl": "https://github.com/junegunn/fzf",
      "packageIds": {
        "scoop": "main/fzf",
        "winget": "junegunn.fzf"
      },
      "description": "🌸 A command-line fuzzy finder"
    },
    {
      "name": "gum",
      "sourceUrl": "https://github.com/charmbracelet/gum",
      "packageIds": {
        "scoop": "charm-gum",
        "winget": "charmbracelet.gum"
      },
      "description": "A tool for glamorous shell scripts 🎀"
    },
    {
      "name": "bat",
      "sourceUrl": "https://github.com/sharkdp/bat",
      "packageIds": {
        "scoop": "main/bat",
        "winget": "sharkdp.bat"
      },
      "description": "A cat(1) clone with wings."
    },
    {
      "name": "delta",
      "sourceUrl": "https://github.com/dandavison/delta",
      "packageIds": {
        "scoop": "main/delta",
        "winget": "dandavison.delta"
      },
      "description": "A syntax-highlighting pager for git, diff, grep, rg --json, and blame output"
    },
    {
      "name": "fd",
      "sourceUrl": "https://github.com/sharkdp/fd",
      "packageIds": {
        "scoop": "main/fd",
        "winget": "sharkdp.fd"
      },
      "description": "A simple, fast and user-friendly alternative to 'find'"
    },
    {
      "name": "eza",
      "sourceUrl": "https://github.com/eza-community/eza",
      "packageIds": {
        "scoop": "main/eza",
        "winget": "eza-community.eza"
      },
      "description": "A modern alternative to ls"
    },
    {
      "name": "Yazi",
      "sourceUrl": "https://github.com/sxyazi/yazi",
      "packageIds": {
        "scoop": "main/yazi",
        "winget": "sxyazi.yazi"
      },
      "description": "💥 Blazing fast terminal file manager written in Rust, based on async I/O.",
      "shellInit": {
        "command": "yazi",
        "powershell": [
          "# y: open yazi and cd into the directory it was left in",
          "function y",
          "{",
          "  $tmp = (New-TemporaryFile).FullName",
          "  yazi.exe $args --cwd-file=\"$tmp\"",
          "  $cwd = Get-Content -Path $tmp -Encoding UTF8",
          "  if ($cwd -and $cwd -ne $PWD.Path -and (Test-Path -LiteralPath $cwd -PathType Container))",
          "  {",
          "    Set-Location -LiteralPath (Resolve-Path -LiteralPath $cwd).Path",
          "  }",
          "  Remove-Item -Path $tmp",
          "}"
        ]
      }
    },
    {
      "name": "xh",
      "sourceUrl": "https://github.com/ducaale/xh",
      "packageIds": {
        "scoop": "main/xh",
        "winget": "ducaale.xh"
      },
      "description": "Friendly and fast tool for sending HTTP requests"
    },
    {
      "name": "jq",
      "sourceUrl": "https://github.com/jqlang/jq",
      "packageIds": {
        "scoop": "main/jq",
        "winget": "jqlang.jq"
      },
      "description": "Command-line JSON processor"
    },
    {
      "name": "zellij",
      "sourceUrl": "https://github.com/zellij-org/zellij",
      "packageIds": {
        "scoop": "main/zellij",
        "winget": "Zellij.Zellij"
      },
      "description": "A terminal workspace with batteries included"
    },
    {
      "name": "bottom",
      "sourceUrl": "https://github.com/ClementTsang/bottom",
      "packageIds": {
        "scoop": "main/bottom",
        "winget": "Clement.bottom"
      },
      "description": "Yet another cross-platform graphical process/system monitor."
    },
    {
      "name": "dust",
      "sourceUrl": "https://github.com/bootandy/dust",
      "packageIds": {
        "scoop": "main/dust",
        "winget": "bootandy.dust"
      },
      "description": "A more intuitive version of du in rust"
    },
    {
      "name": "ouch",
      "sourceUrl": "https://github.com/ouch-org/ouch",
      "packageIds": {
        "scoop": "main/ouch"
      },
      "description": "Painless compression and decompression in the terminal"
    },
    {
      "name": "gsudo",
      "sourceUrl": "https://github.com/gerardog/gsudo",
      "packageIds": {
        "scoop": "main/gsudo",
        "winget": "gerardog.gsudo"
      },
      "description": "Sudo for Windows"
    },
    {
      "name": "ffsend",
      "sourceUrl": "https://github.com/timvisee/ffsend",
      "packageIds": {
        "scoop": "main/ffsend",
        "winget": "TimVisee.ffsend"
      },
      "description": "📬 Easily and securely share files from the command line. A fully featured Firefox Send client."
    }
  ],
  "server": [],
